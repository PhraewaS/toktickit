// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model RequesterUser {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(254)
  isActive  Boolean  @default(true)
  passwordHash       String   @db.VarChar(255)
  role      UserRole @default(REQUESTER)
  mustChangePassword Boolean  @default(true)
  lastLoginAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tickets   Ticket[]
  ownedTickets Ticket[] @relation("TicketOwner")
  sessions  Session[]
  publicComments PublicComment[]
  internalNotes InternalNote[]

  @@index([isActive, name, id], map: "requester_users_active_name_idx")
  @@index([role, isActive, name, id], map: "requester_users_role_active_name_idx")
  @@map("requester_users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tickets   Ticket[]

  @@index([isActive, name, id], map: "categories_active_name_idx")
  @@map("categories")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tickets   Ticket[]

  @@index([isActive, name, id], map: "related_systems_active_name_idx")
  @@map("related_systems")
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique @db.VarChar(21)
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String            @db.VarChar(150)
  requestedPriority RequestedPriority
  description       String
  currentStatus     TicketStatus      @default(NEW)
  itPriority        RequestedPriority @default(MEDIUM)
  ownerId           Int?
  requesterResolvedAt DateTime?       @db.Timestamptz(3)
  submissionKey     String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  requester         RequesterUser     @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner             RequesterUser?    @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]

  @@unique([requesterId, submissionKey], map: "tickets_requester_submission_key")
  @@index([requesterId, createdAt, id], map: "tickets_requester_created_idx")
  @@index([requesterId, updatedAt, id], map: "tickets_requester_updated_idx")
  @@index([requesterId, ticketNumber, id], map: "tickets_requester_number_idx")
  @@index([requesterId, categoryId], map: "tickets_requester_category_idx")
  @@index([requesterId, relatedSystemId], map: "tickets_requester_system_idx")
  @@index([requesterId, requestedPriority], map: "tickets_requester_priority_idx")
  @@index([requesterId, currentStatus], map: "tickets_requester_status_idx")
  @@index([currentStatus, itPriority, ownerId, updatedAt, id], map: "tickets_staff_queue_idx")
  @@map("tickets")
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String    @db.VarChar(255)
  storedFilename   String    @unique @db.Uuid
  mimeType         String    @db.VarChar(100)
  sizeBytes        Int
  uploadedAt       DateTime  @default(now()) @db.Timestamptz(3)
  removedAt        DateTime? @db.Timestamptz(3)
  removalReason    String?   @db.VarChar(500)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, removedAt, uploadedAt, id], map: "attachments_ticket_state_idx")
  @@map("attachments")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(128)
  userId    Int
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      RequesterUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_expiry_idx")
  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    RequesterUser @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, createdAt, id], map: "public_comments_ticket_created_idx")
  @@map("public_comments")
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    RequesterUser @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, createdAt, id], map: "internal_notes_ticket_created_idx")
  @@map("internal_notes")
}
